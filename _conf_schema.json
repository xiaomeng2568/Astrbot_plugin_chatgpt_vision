{
  "backend": {"description":"识图方式","type":"string","default":"existing","options":["existing","chatgpt_oauth"],"labels":["原有转述","ChatGPT OAuth"],"hint":"选择本插件或原有转述。"},
  "allowed_group_ids": {"description":"目标群","type":"list","default":[],"_special":"umo","hint":"只选群聊，选中后全员可用；兼容旧群号。"},
  "group_member_auth": {"description":"群内单独授权","type":"bool","default":false,"hint":"开启后仅名单成员和机器人管理员可用。"},
  "group_allowed_user_ids": {"description":"群内可用成员","type":"list","default":[],"_special":"sender_id","condition":{"group_member_auth":true},"hint":"用于所有目标群，与私聊名单独立。"},
  "allowed_user_ids": {"description":"私聊可用用户","type":"list","default":[],"_special":"sender_id","hint":"仅名单用户和机器人管理员可私聊使用。"},
  "auto_reply": {"description":"自动识图","type":"bool","default":false,"hint":"处理已唤醒的附图消息，注意避免旧插件重复回复。"},
  "include_replied_images": {"description":"允许引用识图","type":"bool","default":true,"hint":"引用原图后发送 /OAuth识图；自动模式只看附图。"},
  "inherit_persona": {"description":"继承当前人格","type":"bool","default":true,"hint":"简短中文、纯文本；OCR忠实原文。"},
  "openai_proxy": {"description":"OpenAI代理","type":"string","default":"","hint":"留空走系统代理；仅支持HTTP/HTTPS。"},
  "image_proxy": {"description":"图片下载代理","type":"string","default":"","hint":"留空走系统代理，与OpenAI代理独立。"},
  "qq_platforms": {"description":"QQ适配器类型","type":"list","default":["aiocqhttp","qq_official","qq_official_webhook"],"hint":"通常无需修改。"},
  "max_reply_chars": {"description":"回复字符上限","type":"int","default":500},
  "max_image_edge": {"description":"图片最长边","type":"int","default":2048,"hint":"512～4096；长截图可设4096。"},
  "request_timeout": {"description":"请求超时秒数","type":"int","default":90},
  "trusted_image_dirs": {"description":"可信图片目录","type":"list","default":[],"hint":"仅添加专用缓存目录，勿填整盘或凭据目录。"}
}
