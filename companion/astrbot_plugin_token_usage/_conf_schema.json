{
  "enabled": {"description":"记录模型用量","type":"bool","default":true,"hint":"仅记录返回的用量，不额外调用模型。"},
  "query_access": {"description":"谁能查询","type":"string","options":["admins","current_session"],"labels":["仅管理员","成员可查当前会话"],"default":"admins"},
  "card": {"description":"发送统计卡片","type":"bool","default":true,"hint":"缺少中文字体时自动返回文本。"},
  "retention_days": {"description":"保留天数","type":"int","default":90,"hint":"累计仅含保留期内记录。"},
  "max_records": {"description":"记录数量上限","type":"int","default":100000},
  "prices": {"description":"模型单价","type":"template_list","default":[],"hint":"单位：每百万Token；空白为未知，不是免费。","templates":{
    "price": {"name":"模型价格","display_item":"model","items":{
      "provider":{"description":"提供商ID","type":"string","default":"","hint":"留空匹配任意提供商。"},
      "model":{"description":"模型名称","type":"string","default":"","hint":"与返回的实际模型名完全一致。"},
      "billing":{"description":"计费类型","type":"string","options":["api","subscription","local"],"labels":["API单价估算","订阅用量","本地调用"],"default":"api"},
      "currency":{"description":"币种","type":"string","options":["CNY","USD","EUR"],"default":"CNY","condition":{"billing":"api"}},
      "input":{"description":"普通输入单价","type":"string","default":"","condition":{"billing":"api"}},
      "cached":{"description":"缓存读取单价","type":"string","default":"","condition":{"billing":"api"}},
      "write":{"description":"缓存写入单价","type":"string","default":"","hint":"接口单列缓存写入时必填。","condition":{"billing":"api"}},
      "output":{"description":"输出单价","type":"string","default":"","condition":{"billing":"api"}}
    }}
  }}
}
